# SQL Server (origem)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=seu_banco
DB_USER=usuario
DB_PASSWORD=senha
DB_TIMEOUT=30
DB_LOGIN_TIMEOUT=10

# Tabela a ser exportada (opcional: coluna para ordenar, ex. id)
DB_TABLE=sua_tabela
DB_ORDER_COLUMN=id

# API de destino
API_BASE_URL=http://localhost:8080/api
API_JWT_TOKEN=seu_token_jwt_aqui

# Tamanho do lote
BATCH_SIZE=1000
